[Unit]
Description=Nova Control — perfis térmicos, curva de fans e iluminação
After=graphical-session.target

[Service]
ExecStart=/usr/bin/env nova-control daemon
# sem isto o journal identifica os logs como "env"
SyslogIdentifier=nova-control
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
